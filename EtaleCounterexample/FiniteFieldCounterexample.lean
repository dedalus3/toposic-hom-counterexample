import EtaleCounterexample.LocalizedEtaleEndomorphisms
import EtaleCounterexample.ToposPointSpace

set_option autoImplicit false
noncomputable section
open CategoryTheory AlgebraicGeometry

namespace EtaleCounterexample
universe u
variable (k : Type u) [Field k] [Fintype k]

/-- The explicit twist fixes every underlying topos point, hence is pinned
for the actual point-space topology generated by subterminal supports. -/
theorem nonintegralTwist_isPinned :
    (nonintegralTwist k (multiplicativeGroupStructure k)).geometric.IsPinned.{u} :=
  geometricIdentity_isPinned

/-- The finite-field counterexample in exhaustive UH-roof form: a pinned
relative self-equivalence of the actual small étale topos of G_m which is not
induced, through any UH roof, by any arrow of the actual finite-type
Gabriel–Zisman localization. The algebraic closure and characteristic are
supplied internally; no comparison or obstruction hypotheses occur. -/
theorem finiteField_counterexample_roofForm :
    ∃ T : RelativeMorphism (etaleDirectImage (multiplicativeGroupStructure k))
        (etaleDirectImage (multiplicativeGroupStructure k)),
      IsRelativeEquivalence T ∧ T.geometric.IsPinned.{u} ∧
      ∀ a : (relativeUH (Spec (.of k))).Q.obj (multiplicativeGroupFiniteType k) ⟶
          (relativeUH (Spec (.of k))).Q.obj (multiplicativeGroupFiniteType k),
        ¬ IsInducedByLocalizedEndomorphism k a T := by
  let p := ringChar k
  let : Fact p.Prime := ⟨CharP.prime_ringChar k⟩
  refine ⟨nonintegralTwist k (multiplicativeGroupStructure k),
    nonintegralTwist_isRelativeEquivalence k _, nonintegralTwist_isPinned k, ?_⟩
  intro a
  exact nonintegralTwist_not_induced k p (AlgebraicClosure k) a

end EtaleCounterexample
