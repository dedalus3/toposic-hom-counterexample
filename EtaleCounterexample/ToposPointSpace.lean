import EtaleCounterexample.RelativeIsoCalculus
import Mathlib.CategoryTheory.Subterminal
import Mathlib.Topology.Defs.Filter
import Mathlib.Topology.Order

set_option autoImplicit false
noncomputable section
open CategoryTheory CategoryTheory.Functor

namespace EtaleCounterexample
universe u v w v' w'
variable (E : Type v) [Category.{w} E]

/-- Isomorphism of actual geometric points is expressed on the direct images;
the inverse-image mate gives the equivalent usual definition. -/
def toposPointSetoid : Setoid (GeometricMorphism (Type u) E) where
  r a b := Nonempty (a.directImage ≅ b.directImage)
  iseqv := ⟨fun _ ↦ ⟨Iso.refl _⟩,
    fun ⟨e⟩ ↦ ⟨e.symm⟩, fun ⟨e⟩ ⟨f⟩ ↦ ⟨e ≪≫ f⟩⟩

/-- The `Type u`-valued point space of an actual topos category. Its universe
is `max (u+1) v w`; no smallness of the collection of all points is presumed. -/
def ToposPointSpace := Quotient (toposPointSetoid.{u} E)

/-- The standard topology generated by supports of subterminal objects. A
support consists of point classes whose inverse image of that object is
inhabited. The existential representative makes saturation explicit. -/
instance toposPointSpaceTopology : TopologicalSpace (ToposPointSpace.{u} E) :=
  TopologicalSpace.generateFrom {U | ∃ (A : E), IsSubterminal A ∧
    U = {q | ∃ p : GeometricMorphism (Type u) E,
      Quotient.mk (toposPointSetoid E) p = q ∧ Nonempty (p.inverseImage.obj A)}}

variable {E} {D : Type v'} [Category.{w'} D]

/-- The map on point classes induced by composing genuine geometric morphisms. -/
def GeometricMorphism.pointMap (f : GeometricMorphism E D) :
    ToposPointSpace.{u} E → ToposPointSpace.{u} D :=
  Quotient.map (fun p ↦ p.comp f) (fun _ _ ⟨e⟩ ↦ ⟨isoWhiskerRight e f.directImage⟩)

/-- Pinned means that the induced map on the underlying point spaces carries
closed points to closed points, with the usual singleton criterion. -/
def GeometricMorphism.IsPinned (f : GeometricMorphism E D) : Prop :=
  ∀ q : ToposPointSpace.{u} E, IsClosed ({q} : Set (ToposPointSpace.{u} E)) →
    IsClosed ({f.pointMap q} : Set (ToposPointSpace.{u} D))

theorem geometricIdentity_pointMap (q : ToposPointSpace.{u} E) :
    (GeometricMorphism.id E).pointMap q = q := by
  induction q using Quotient.inductionOn with
  | h p => exact Quotient.sound ⟨p.directImage.rightUnitor⟩

theorem geometricIdentity_isPinned : (GeometricMorphism.id E).IsPinned.{u} := by
  intro q hq
  simpa only [geometricIdentity_pointMap] using hq

end EtaleCounterexample
